{
    "name": "yiendos/my-sites-ide-mail-mailhog",
    "description": "MailHog mail catcher - an SMTP server that keeps every email your sites send, with a web UI to read them - for my-sites-ide",
    "type": "my-sites-ide-plugin",
    "license": "MIT",
    "keywords": ["my-sites-ide", "mailhog", "smtp", "email", "mailcatcher"],
    "authors": [
        {
            "name": "Paul Yiend",
            "email": "yiendos@sbmatrix.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Yiendos\\MySitesIde\\Mail\\Mailhog\\": "src/"
        }
    },
    "require": {
        "php": "^8.2",
        "symfony/console": "^7.3"
    },
    "extra": {
        "my-sites-ide": {
            "commands": "src/Console",
            "compose": "docker-compose.yml",
            "env": ".env",
            "env-example": "env-example",
            "services": ["mailhog"],
            "autostart": true
        }
    }
}
